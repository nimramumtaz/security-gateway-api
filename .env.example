# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# JWT Secrets (use long random strings in production)
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string_access
REFRESH_TOKEN_SECRET=replace_with_a_long_random_string_refresh
SESSION_SECRET=replace_with_a_long_random_string_session

# Google OAuth 2.0 (get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
